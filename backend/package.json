{
  "name": "backend",
  "version": "0.0.1",
  "description": "NestJS backend application",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ormconfig.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/migrations/InitialMigration",
    "migration:run": "npm run typeorm -- migration:run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "mysql2": "^3.22.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.1",
    "@nestjs/testing": "^10.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
